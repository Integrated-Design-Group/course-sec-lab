# 统一换行符：仓库内一律 LF，避免 Windows 检出把 shell 脚本变成 CRLF
* text=auto eol=lf

*.sh text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf

# 二进制/图片不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
