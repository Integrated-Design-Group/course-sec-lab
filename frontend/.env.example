# 前端环境变量模板
# 用法：cp frontend/.env.example frontend/.env
# 说明：Vite 只暴露以 VITE_ 开头的变量，禁止把密钥写进前端变量。

# API 基础路径：开发期走 Vite 代理，生产期走 Nginx 同源反代
VITE_API_BASE_URL=/api/v1

# 开发期 Vite 代理目标（可选；默认 http://127.0.0.1:3000）
VITE_DEV_PROXY_TARGET=http://127.0.0.1:3000

# 页面标题（构建时注入）
VITE_APP_TITLE=课程安全靶场 · 校园二手教材交易平台
