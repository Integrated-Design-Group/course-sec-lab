# ===========================================================================
# 课程安全靶场（框架阶段）环境变量模板
# 用法：cp .env.example .env  然后把所有 __CHANGE_ME__ 替换为本机/部署环境的值。
# 严禁把真实密码、云密钥、公网地址提交到仓库。
# 生成随机值示例：openssl rand -hex 32
# ===========================================================================

# ---------- 运行时 ----------
NODE_ENV=development
APP_NAME=course-sec-lab
APP_VERSION=0.1.0
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173
# 反向代理层数；直接本机运行填 0，经 Nginx 部署填 1
TRUST_PROXY=0
LOG_LEVEL=info
LOG_DIR=./logs
LOG_TO_FILE=false
# 是否允许进程内内存驱动（仅框架阶段本地演示，部署必须为 mysql）
DB_DRIVER=memory

# 课程内网全量靶场（仅 vuln/ALL）：默认 5 个漏洞全开；测试后改回 off
VULN_MODE=ALL

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=course_sec_lab
DB_USER=lab_user
DB_PASSWORD=__CHANGE_ME_DB_PASSWORD__
DB_ROOT_PASSWORD=__CHANGE_ME_DB_ROOT_PASSWORD__
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=10000
# 仅 docker-compose.dev.yml 使用：把 MySQL 映射到 127.0.0.1 的端口，冲突时改为 3307
DB_PUBLISH_PORT=3306

# ---------- 认证 ----------
# 必须 >= 32 字符且不是模板占位值，生产环境启动时会强校验
JWT_SECRET=__CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS__
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=10
LOGIN_RATE_LIMIT_WINDOW_MS=600000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10

# ---------- 上传 ----------
# 相对 backend/ 目录；生产环境挂载独立数据卷
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=2097152
UPLOAD_ALLOWED_MIME=image/png,image/jpeg,image/webp

# ---------- 部署占位（只写占位符，不填真实值） ----------
# 公网入口端口（Nginx）；安全组仅放行该端口与 443（HTTPS 规划中）
PUBLIC_HTTP_PORT=80
DEPLOY_PUBLIC_HOST=__PUBLIC_IP_OR_DOMAIN__
DEPLOY_SSH_ALLOWED_CIDR=__YOUR_ADMIN_CIDR__
# 服务器与数据库统一使用 UTC；展示层按 Asia/Shanghai 渲染
DEPLOY_TIMEZONE=UTC
